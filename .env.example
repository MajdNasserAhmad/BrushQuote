# Supabase project URL and public anon (or publishable) key. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; required later for restricted public submission/portal workflows.
SUPABASE_SERVICE_ROLE_KEY=
# Public form HMAC secret: generate at least 32 random characters, server-only.
PUBLIC_REQUEST_SIGNING_SECRET=
# Set only behind a trusted proxy that overwrites this header. Blank uses a shared business limit.
PUBLIC_REQUEST_IP_HEADER=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Milestone 3: Groq is the only implemented AI provider. No OpenAI API key.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
AI_ENABLED=true
AI_VISION_ENABLED=true
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_INPUT_CHARACTERS=24000
AI_TIMEOUT_MS=20000
# Optional JSON map by model: {"model-id":{"input_per_million":"0.00","output_per_million":"0.00","version":"your-price-date"}}
# Use actual verified rates. Blank means cost is unknown, never zero.
AI_MODEL_PRICING_JSON=

# Milestone 4: use a verified sender domain in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Signing secret for /api/email/webhook. Required for verified delivery updates.
RESEND_WEBHOOK_SECRET=
# Public support address shown on /contact. Never put a secret here.
SUPPORT_EMAIL=
